{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 1095,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "mcp__claude_ai_Slack__slack_list_channels",
      "mcp__claude_ai_Slack__slack_get_channel_history",
      "mcp__claude_ai_Slack__slack_get_thread_replies",
      "mcp__claude_ai_Slack__slack_get_users",
      "mcp__claude_ai_Slack__slack_search_messages",
      "mcp__claude_ai_Google_Calendar__gcal_list_events",
      "mcp__claude_ai_Google_Calendar__gcal_list_calendars",
      "mcp__claude_ai_Google_Calendar__gcal_get_event"
    ],
    "deny": [
      "Bash(chmod 777 /*)",
      "Bash(chmod -R *)",
      "Bash(chown root:*)",
      "Bash(chown -R *)",
      "Bash(docker system prune:*)",
      "Bash(docker push *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git commit --amend:*)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git reset --hard *)",
      "Bash(gcloud * --quiet)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(npm publish *)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(pnpm publish *)",
      "Bash(pkill *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf:*)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo:*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)",
      "Bash(yarn publish *)",
      "Bash(*deploy*)",
      "Bash(aws * --no-cli-pager)",
      "Bash(defaults write *)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/credentials.csv)",
      "Read(**/.credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/.secrets)",
      "Read(**/*.secret)",
      "Read(**/*.secret.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.env)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(.env)",
      "Write(.env.development)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/credentials)",
      "Write(**/credentials.json)",
      "Write(**/.credentials)",
      "Write(**/secrets.json)",
      "Write(**/secrets.yaml)",
      "Write(**/secrets.yml)",
      "Write(**/.secrets)",
      "Write(**/*.secret)",
      "Write(**/*.secret.*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(git add:*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(brew install *)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "claude-opus-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-push-to-main.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-sensitive-reads.sh"
          }
        ]
      }
    ],
    "Notification": [],
    "Stop": [],
    "SessionEnd": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "carta-agent-skills": {
      "source": {
        "source": "github",
        "repo": "voyagegroup/agent-skills"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/pre-commit"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gcloud",
        "~/.bash_history",
        "~/.zsh_history"
      ],
      "allowRead": [
        "~/.ssh/known_hosts"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git"
    ]
  },
  "effortLevel": "xhigh",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754040541141
  }
}
