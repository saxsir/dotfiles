{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 1095,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_NEW_INIT": "1",
    "ENABLE_LSP_TOOL": "1",
    "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/coreutils/libexec/gnubin:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/bin:/usr/local/bin:/Applications/cmux.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__claude_ai_Slack__slack_list_channels",
      "mcp__claude_ai_Slack__slack_get_channel_history",
      "mcp__claude_ai_Slack__slack_get_thread_replies",
      "mcp__claude_ai_Slack__slack_get_users",
      "mcp__claude_ai_Slack__slack_search_messages",
      "mcp__claude_ai_Google_Calendar__gcal_list_events",
      "mcp__claude_ai_Google_Calendar__gcal_list_calendars",
      "mcp__claude_ai_Google_Calendar__gcal_get_event"
    ],
    "deny": [
      "Bash(chmod 777 /*)",
      "Bash(chmod -R *)",
      "Bash(chown root:*)",
      "Bash(chown -R *)",
      "Bash(docker system prune:*)",
      "Bash(docker push *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git commit --amend:*)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge:*)",
      "Bash(gcloud * --quiet)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(npm publish *)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(pnpm publish *)",
      "Bash(pkill *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf:*)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo:*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)",
      "Bash(yarn publish *)",
      "Bash(*deploy*)",
      "Bash(aws * --no-cli-pager)",
      "Bash(defaults write *)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/credentials.csv)",
      "Read(**/.credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/.secrets)",
      "Read(**/*.secret)",
      "Read(**/*.secret.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.env)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.development)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/credentials)",
      "Edit(**/credentials.json)",
      "Edit(**/.credentials)",
      "Edit(**/secrets.json)",
      "Edit(**/secrets.yaml)",
      "Edit(**/secrets.yml)",
      "Edit(**/.secrets)",
      "Edit(**/*.secret)",
      "Edit(**/*.secret.*)"
    ],
    "ask": [
      "Bash(gh pr ready:*)",
      "Bash(rm:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(brew install *)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "claude-opus-4-7",
  "skillOverrides": {
    "claude-api": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-push-to-main.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-sensitive-reads.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-finalize.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-gh-body-overwrite.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-aws-vault-write.sh"
          }
        ]
      }
    ],
    "Notification": [],
    "Stop": [],
    "SessionEnd": [],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/superpowers/hooks/run-hook.cmd session-start",
            "async": false
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "crit plan-hook",
            "timeout": 345600
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "carta-agent-skills": {
      "source": {
        "source": "github",
        "repo": "voyagegroup/agent-skills"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754040541141
  }
}
