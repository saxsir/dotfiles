{{- /* fluct の entryplug を clone してある端末（会社の端末）でだけ fluct の plugin を足す。
     entryplug の devbox は CLAUDE_CONFIG_DIR ごと差し替えて個人設定と共存できないため、vanilla 側に取り込む。
     fluct-core は claude.ai の組織配布で入るので、ここでは足さない（足すと二重になる）。 */ -}}
{{- $entryplug := stat (joinPath .chezmoi.homeDir ".config/fluct/entryplug") -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(crit comment *)",
      "Bash(crit comments *)"
    ]
  },
  "skillOverrides": {
    "crit": "user-invocable-only",
    "crit-story": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "dude@dude": true,
    "superpowers@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
{{- if $entryplug }},
    "fluct-ops@fluct": true,
    "fluct-design@fluct": true,
    "fluct-review@fluct": true
{{- end }}
  },
  "extraKnownMarketplaces": {
    "dude": {
      "source": {
        "source": "github",
        "repo": "yowcow/dude"
      },
      "autoUpdate": true
    }
{{- if $entryplug }},
    "fluct": {
      "source": {
        "source": "directory",
        "path": "~/.config/fluct/entryplug"
      }
    }
{{- end }}
  },
  "language": "Japanese",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "claudeMdExcludes": [
    "{{ .chezmoi.homeDir }}/.claude/**"
  ],
  "theme": "dark",
  "allowedMcpServers": [
    {
      "serverName": "chrome-devtools"
    },
    {
      "serverUrl": "https://mcp.slack.com/mcp"
    },
    {
      "serverUrl": "https://*.snowflakecomputing.com/*"
    }
{{- if $entryplug }},
    {
      "serverUrl": "https://*.api.scs.splunk.com/*"
    },
    {
      "serverName": "ingred-design-system"
    }
{{- end }}
  ]
}
