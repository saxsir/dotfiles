{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(crit comment *)",
      "Bash(crit comments *)"
    ]
  },
  "skillOverrides": {
    "crit": "user-invocable-only",
    "crit-story": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "dude@dude": true,
    "superpowers@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dude": {
      "source": {
        "source": "github",
        "repo": "yowcow/dude"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "claudeMdExcludes": [
    "{{ .chezmoi.homeDir }}/.claude/**"
  ],
  "theme": "dark"
}
