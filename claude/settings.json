{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 1095,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(chmod 777 /*)",
      "Bash(chown root:*)",
      "Bash(curl:*)",
      "Bash(docker system prune:*)",
      "Bash(git commit --amend:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(**/*credentials*)",
      "Read(**/*key*)",
      "Read(**/*secret*)",
      "Read(**/.env)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(.env)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(id_rsa)",
      "Write(**/.env)",
      "Write(**/.env.development)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(.env)",
      "Write(.env.development)",
      "Write(.env.local)",
      "Write(.env.production)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(git add -A:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [],
    "Stop": [],
    "SessionEnd": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "carta-agent-skills": {
      "source": {
        "source": "github",
        "repo": "voyagegroup/agent-skills"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "high",
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754040541141
  }
}
