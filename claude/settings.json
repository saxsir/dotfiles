{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 1095,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gcloud",
        "~/.bash_history",
        "~/.zsh_history"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search:*)",
      "Bash(git add -p:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(chmod 777 /*)",
      "Bash(chmod -R *)",
      "Bash(chown root:*)",
      "Bash(chown -R *)",
      "Bash(docker system prune:*)",
      "Bash(docker push *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git commit --amend:*)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git reset --hard *)",
      "Bash(gcloud * --quiet)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(npm publish *)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(pnpm publish *)",
      "Bash(pkill *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf:*)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo:*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)",
      "Bash(yarn publish *)",
      "Bash(*deploy*)",
      "Bash(aws * --no-cli-pager)",
      "Bash(defaults write *)",
      "Read(**/*credentials*)",
      "Read(**/*key*)",
      "Read(**/*secrets*)",
      "Read(**/*.secret)",
      "Read(**/*.secret.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(.env)",
      "Read(.env.development)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(id_rsa)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(.env)",
      "Write(.env.development)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*credentials*)",
      "Write(**/*secrets*)",
      "Write(**/*.secret)",
      "Write(**/*.secret.*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(git add:*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(brew install *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-push-to-main.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-sensitive-reads.sh"
          }
        ]
      }
    ],
    "Notification": [],
    "Stop": [],
    "SessionEnd": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "carta-agent-skills": {
      "source": {
        "source": "github",
        "repo": "voyagegroup/agent-skills"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "high",
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754040541141
  }
}
