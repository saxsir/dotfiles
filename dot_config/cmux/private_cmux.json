{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // This file uses JSON with comments (JSONC).
  // Uncomment and edit any setting to make it file-managed.
  // Remove a setting to fall back to the value saved in Settings.
  // cmux creates this template on launch when ~/.config/cmux/cmux.json is missing.
  // Legacy settings.json files are read only as fallback for keys not present here.

  // ---- file-managed: 意図して default から変えた値のみ書く (下の全キーコメントは参照用テンプレ) ----

  "app": {
    "openMarkdownInCmuxViewer": true,
    "reorderOnNotification": false,  // サイドバーの並びは自分で管理する (通知で動かさない)
    "newWorkspacePlacement": "end"   // 新規 workspace は末尾へ。既存の位置記憶を崩さない
  },

  "notifications": {
    "sound": "none"  // 複数 agent 並行だと音は過剰。視覚シグナル (バッジ/リング) は default 維持
  },

  "sidebar": {
    "hideAllDetails": true,
    "showPullRequests": false
  },

  "browser": {
    "openTerminalLinksInCmuxBrowser": false,       // リンクは外部ブラウザで開く
    "hostsToOpenInEmbeddedBrowser": ["localhost"]  // localhost だけ埋め込みブラウザに残す
  },

  "shortcuts": {
    "bindings": {
      "globalSearch": null  // 既定 cmd+opt+f はシステム全体ホットキーで Raycast のウィンドウ操作と衝突。未使用機能なので未割り当てに
    }
  },

  // Catppuccin Mocha 由来のパレット。参照は herdr (https://herdr.dev, https://github.com/ogulcancelik/herdr)
  // src/app/state.rs::Palette::catppuccin() から採取。cmux 既定は彩度が高すぎるので、
  // Mocha 系の 16 色 (Brown / Olive は Mocha に無いので aesthetic を合わせて自作) に置き換える
  "workspaceColors": {
    "colors": {
      "Amber":    "#F9E2AF",  // yellow
      "Aqua":     "#89DCEB",  // sky
      "Blue":     "#89B4FA",  // blue (accent)
      "Brown":    "#B08968",  // Mocha に無いので dusty mocha 系を追加
      "Charcoal": "#7F849C",  // overlay1
      "Crimson":  "#EBA0AC",  // maroon
      "Green":    "#A6E3A1",  // green
      "Indigo":   "#B4BEFE",  // lavender
      "Magenta":  "#F5C2E7",  // pink
      "Navy":     "#74C7EC",  // sapphire
      "Olive":    "#C6D07F",  // Mocha に無いので muted sage-olive を追加
      "Orange":   "#FAB387",  // peach
      "Purple":   "#CBA6F7",  // mauve
      "Red":      "#F38BA8",  // red
      "Rose":     "#F2CDCD",  // flamingo
      "Teal":     "#94E2D5"   // teal
    }
  },

