# Ghostty Configuration
# https://ghostty.org/docs/config

# Font
# Moralerspace Neon JPDOC = Moralerspace の JPDoc 派生。「」、。等の全角記号を JP 側 (IBM Plex Sans JP) で描画
font-family = "Moralerspace Neon JPDOC"
font-size = 13

# Moralerspace の JPDOC は ①②③ (Enclosed Alphanumerics) を Monaspace 側の半角グリフで描く。
# 全角で読みやすくするため、丸数字ブロックだけ IBM Plex Sans JP に強制マッピング
# (Moralerspace の JP 側と同じ書体なので字形が揃う)
font-codepoint-map = U+2460-U+24FF=IBM Plex Sans JP

# Scrollback
scrollback-limit = 50000

# Splits
unfocused-split-opacity = 0.85
split-divider-color = #3e4451

# Working directory
working-directory = ~/
